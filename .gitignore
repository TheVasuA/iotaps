# Environment / secrets
.env
*.env.local
# Real production secrets — never commit. Use .env.example as the template.
.env.production
app/secrets/
infra/nginx/certs/

# Kubernetes secrets consumed by kustomize secretGenerator — never commit.
# Use the secrets.env.example in each overlay as the template.
k8s/overlays/*/secrets.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.hypothesis/

# Node / frontend
node_modules/
web/dist/
web/.vite/

# Regenerated from web/public/marketing/*.jpg by web/scripts/optimize-images.mjs
# (run `npm run images`, or `npm run build` which starts with it). The 8 source
# JPEGs are committed; their avif/webp/jpg variants and the manifest they
# produce are build output.
web/public/marketing/optimized/
web/src/lib/marketingImages.generated.js

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs / OS
*.log
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes (local dev)
postgres_data/
redis_data/
mosquitto_data/
mosquitto_log/

# Seed scripts (dev-only, not for production)
seed_*.py

# Build artifacts
*.egg
dist/
build/

# Kiro
.kiro/
