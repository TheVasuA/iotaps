# Production env vars (Vite build time) — SINGLE-ORIGIN VPS DEPLOY.
# Nginx serves web/dist and proxies /api/ and /ws on the same origin, so the
# API and WebSocket URLs are left relative. This means:
#   - no CORS (same origin), no api.* subdomain, one TLS cert
#   - the SPA works on any hostname/IP it is served from
# apiClient.js falls back to "/api/v1" and realtime.js builds
# wss://<current-host>/ws when these are unset, so both stay blank.
VITE_API_BASE_URL=/api/v1

# Leave blank: realtime.js derives wss://<current-host>/ws automatically.
VITE_WS_URL=

# Google OAuth — client IDs are public by design, safe to commit.
VITE_GOOGLE_CLIENT_ID=622587244689-ok0kqi83d23u2esdv5pk6t0alen4jro2.apps.googleusercontent.com
