# Copy to `secrets.env` in this directory and fill in real values.
#   cp secrets.env.example secrets.env
# `secrets.env` is gitignored. NEVER commit it.
#
# Kustomize turns this into the `iotaps-secrets` Secret. The name carries a
# content hash, so changing a value here rolls the pods that consume it.
#
# ---------------------------------------------------------------------------
# IMPORTANT: use URL-SAFE passwords (letters and digits only).
# ---------------------------------------------------------------------------
# DATABASE_URL and REDIS_URL are assembled inside the pod from these parts, e.g.
#   postgresql+asyncpg://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@iotaps-postgres:5432/$(POSTGRES_DB)
# A password containing @ : / ? # % or a space corrupts that URL. Generate one
# with:  openssl rand -hex 24
#
# If you must use a non-URL-safe password, or you are pointing at a managed
# database instead of the in-cluster one, delete the assembled DATABASE_URL /
# REDIS_URL env entries from api.yaml, ws.yaml, workers.yaml and job-migrate.yaml
# and add the full URLs here as secret keys instead.

# --- Postgres (also used to initialise the in-cluster database on first boot) ---
POSTGRES_USER=iotaps
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_24
POSTGRES_DB=iotaps

# --- Redis ---
REDIS_PASSWORD=REPLACE_ME_openssl_rand_hex_24

# --- JWT signing key ---
# Required. app/core/config.py silently falls back to the literal string
# "change_me_jwt_secret" if this is missing, which would let anyone mint valid
# tokens. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32

# --- Super admin seed ---
# Seeded on pod startup when SUPERADMIN_EMAIL (in config/app.env) is also set.
SUPERADMIN_PASSWORD=REPLACE_ME_strong_password

# --- Razorpay (payments). Leave empty to disable. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP (email notifications and reports). ---
# Also set SMTP_HOST in config/app.env; an empty SMTP_HOST disables email.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- MongoDB identity vault (optional off-cluster mirror). Empty disables it. ---
MONGODB_URI=
