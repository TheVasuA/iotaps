# Non-secret application configuration -> ConfigMap `iotaps-config`.
# Every key here is read by app/core/config.py (pydantic Settings, case-insensitive).
# Secrets live in secrets.env (see k8s/overlays/*/secrets.env.example).
#
# NOTE: app/core/config.py gives every setting a default, so a missing key never
# fails startup -- it silently falls back (e.g. JWT_SECRET -> "change_me_jwt_secret").
# Nothing validates these in production, so treat the secret values as mandatory.

# ---- Application ----
APP_ENV=production
APP_DEBUG=false
PUBLIC_BASE_URL=https://api.iotaps.example.com
CORS_ALLOW_ORIGINS=*
PLATFORM_SETTINGS_CACHE_TTL_SECONDS=300

# Gunicorn worker counts, consumed by the container commands (not by Python).
# Each worker process opens its own SQLAlchemy pool of up to 30 connections
# (pool_size=10 + max_overflow=20, hardcoded in app/db/session.py), so raising
# these multiplies Postgres connection usage. See k8s/README.md.
API_WORKERS=2
WS_WORKERS=2

# ---- MQTT ----
MQTT_HOST=iotaps-mosquitto
MQTT_PORT=1883
MQTT_TOPIC_ROOT=iotaps
# Seconds to wait for Command_ACK before marking a command UNACKNOWLEDGED (0 disables).
COMMAND_ACK_TIMEOUT_SECONDS=30

# ---- JWT / Auth ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
# Empty disables Google OAuth login.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Super admin seed (password lives in the Secret) ----
# SUPERADMIN_EMAIL: promoted to super_admin on startup and on sign-in (OAuth OK).
# SUPERADMIN_PASSWORD: only needed to create a new account if the email is missing.
SUPERADMIN_EMAIL=

# ---- Email ----
# Empty SMTP_HOST disables email entirely (sends become no-ops).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=no-reply@iotaps.com
SMTP_FROM_NAME=IoTAPS
SMTP_USE_TLS=true

# ---- MongoDB identity vault (optional off-cluster mirror) ----
# MONGODB_URI lives in the Secret; empty disables the vault worker.
MONGODB_DB=iotaps_vault
MONGODB_SYNC_INTERVAL_SECONDS=900
